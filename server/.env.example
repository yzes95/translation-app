# Environment variables for LinguaFlow Render Backend (Web Service)
# Paste these directly in your Render Dashboard -> Environment Variables

PORT=5000

# 1. Stripe Restricted Key (starts with rk_live_... or rk_test_...)
# Set with Write permissions for Checkout Sessions
STRIPE_SECRET_KEY=rk_live_your_stripe_key_here

# 2. Stripe Webhook Secret (from Stripe Dashboard -> Developers -> Webhooks -> Add endpoint)
# Endpoint URL: https://linguaflow-api.onrender.com/api/tips/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# 3. Server Gemini API Key (Used to power Smart mode for users without a key)
GEMINI_API_KEY=your_gemini_api_key_here

# 4. Frontend Origin URL (your Render Static Site URL)
APP_ORIGIN=https://linguaflow.onrender.com
